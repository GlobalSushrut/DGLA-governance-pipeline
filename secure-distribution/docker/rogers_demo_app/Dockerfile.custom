FROM python:3.9-slim

WORKDIR /app

# Copy requirements and install dependencies
COPY secure-distribution/docker/rogers_demo_app/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the entire project code to maintain directory structure
COPY . /app/

# Set working directory to the Rogers demo app location
WORKDIR /app/secure-distribution/docker/rogers_demo_app

# Create upload directory
RUN mkdir -p /app/upload_folder

# Expose port
EXPOSE 5000

# Set environment variables
ENV FLASK_APP=app.py
ENV FLASK_ENV=development
ENV PYTHONPATH=/app

# Set entrypoint - use the wrapper script instead of directly running app.py
CMD ["python3", "app-wrapper.py"]
